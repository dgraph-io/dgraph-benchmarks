# Dgraph build to test. Use "local" for a locally built dgraph/dgraph:local
# image, or any published tag (e.g. v25.1.0).
DGRAPH_IMAGE=dgraph/dgraph
DGRAPH_VERSION=local

# Dataset (see datasets.py REGISTRY) and scale.
DATASET=gist-960-euclidean   # or sift-128-euclidean (smaller/faster)
N=200000                     # vectors to load; the full sets have 1,000,000
SAMPLE=1000                  # vectors audited (evenly spaced across N)
K=100                        # self-query top-K

# Implementations to compare (comma-separated): hnsw, partitioned, hnswlib.
INDEX_MODES=hnsw,partitioned,hnswlib

# efConstruction values to sweep — the main lever for the orphan rate.
EF_CONSTRUCTION_LIST=64,200

# HNSW parameters.
HNSW_METRIC=euclidean
HNSW_MAX_LEVELS=3
HNSW_EF_SEARCH=32            # default query beam
EF_RESCUE=2000              # wide beam: separates orphaned from merely beam-limited
HNSW_M=64                   # hnswlib M, matched to dgraph's neighbor-row cap

# Partitioned (IVF) clusters. Leave unset to auto-derive ~N/450.
# NUM_CLUSTERS=448

LIVE_THREADS=8

# Optional label recorded with each results row.
DESC=
